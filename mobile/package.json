{
  "name": "mobile",
  "main": "index.ts",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "lint": "oxlint",
    "test": "bun test tests",
    "apk": "cd android && ./gradlew assembleRelease -x lintVitalRelease -PreactNativeArchitectures=arm64-v8a",
    "apk:devnet": "bun --env-file=.env.devnet apk",
    "apk:mainnet": "bun --env-file=.env.mainnet apk",
    "release:devnet": "HEIRLOOM_CLUSTER=devnet GITHUB_TOKEN=$(gh auth token) release-it",
    "release:mainnet": "HEIRLOOM_CLUSTER=mainnet GITHUB_TOKEN=$(gh auth token) release-it"
  },
