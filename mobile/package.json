    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana-program/token-2022": "^0.19.0",
    "@solana/kit": "^8.4.0",
    "@tanstack/react-query": "^5.104.1",
    "@wallet-ui/react-native-kit": "^4.4.1",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
