EXPO_PUBLIC_SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com

EXPO_PUBLIC_SOLANA_RPC_WS_ENDPOINT=wss://api.devnet.solana.com

EXPO_PUBLIC_BACKEND_URL=http://10.0.2.2:3040

# An RPC that serves the DAS API (token names, prices, wallet tokens). Defaults to the RPC endpoint above,
# which must then support DAS itself; the public api.*.solana.com endpoints don't.
# EXPO_PUBLIC_DAS_RPC_URL=

# Pick check-in and wait in minutes, for demos and testing claims. Ignored on mainnet.
EXPO_PUBLIC_DEMO_TIMING=false
