{
  // Heirloom Stocks, on its own subdomain. Like the app it is client-rendered
  // and wallet-gated, so it keeps the SPA fallback: any path is served the
  // shell and the router takes it from there. Nothing here is meant to be
  // crawled — see public/robots.txt.
  //
  // Deploys are manual: `bun run deploy:stocks` from the repo root builds and
  // uploads it.
  "name": "heirloom-stocks",
  "compatibility_date": "2026-04-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "stocks.heirlm.xyz", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "heirloom-stocks-preview"
    }
  }
}
