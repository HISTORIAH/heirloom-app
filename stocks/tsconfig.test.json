{
  // Everything that runs under Bun rather than in the browser: the unit and
  // builder tests, the localnet and browser suites, and the scripts.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"]
  },
  "include": ["src/**/*.test.ts", "localnet", "e2e", "scripts"],
  "exclude": []
}
