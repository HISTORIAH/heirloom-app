# heirloom-stocks is deployed to devnet.
VITE_SOLANA_SUBSCRIPTIONS_RPC_ENDPOINT=wss://devnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>

# Any RPC works; the plan lookup uses getProgramAccounts, which some free tiers limit.
VITE_SOLANA_RPC_ENDPOINT=https://devnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>

# Where "Home" goes. The marketing site is a separate build on its own origin.
VITE_LANDING_URL=https://heirlm.xyz

# Jupiter, for mainnet prices, holdings, and swaps on /browse. The keyless
# endpoint is the default; a key, if one is ever needed, ships in the bundle.
# VITE_JUPITER_API_URL=https://lite-api.jup.ag
# VITE_JUPITER_API_KEY=
