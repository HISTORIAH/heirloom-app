{
  // The application, on its own subdomain. Client-rendered and wallet-gated,
  // so it keeps the SPA fallback: any path is served the shell and the router
  // takes it from there. Nothing here is meant to be crawled — see
  // public/robots.txt.
  //
  // NOTE: this name must match the Worker that already exists in the account,
  // or `wrangler deploy` creates a second one alongside it. It is deliberately
  // "heirloom" rather than "heirloom-app" for that reason.
  "name": "heirloom",
  "compatibility_date": "2026-04-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // heirlm.xyz is deliberately absent: the apex belongs to the landing worker
  // now. Detach it from this Worker in the dashboard — wrangler attaches the
  // custom domains listed here but does not remove ones that disappear.
  "routes": [{ "pattern": "app.heirlm.xyz", "custom_domain": true }],
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "heirloom-preview"
    }
  }
}
