VITE_SOLANA_SUBSCRIPTIONS_RPC_ENDPOINT=wss://devnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>

VITE_SOLANA_RPC_ENDPOINT=https://devnet.helius-rpc.com/?api-key=<HELIUS_API_KEY>

# Where "Home" and a skipped tour go. The marketing site is a separate build on
# its own origin; point this at a local Astro dev server to test the round trip.
VITE_LANDING_URL=https://heirlm.xyz

# PostHog product analytics. Leave unset to disable analytics locally.
# The host must match the landing's PUBLIC_POSTHOG_HOST — the two share a
# cookie across .heirlm.xyz so one visitor stays one person across the hand-off.
VITE_ANALYTICS_ENABLED=false

VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# only do this for local
VITE_FEATURE_YIELD_STAKING_UI=true

# only do this for local, backend isn't wired up yet
VITE_FEATURE_NOTIFICATIONS_UI=true
