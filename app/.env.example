# Helius API key — used for DAS (Digital Asset Standard) metadata enrichment.
# Get one free at https://dashboard.helius.dev/api-keys
# When set, SPL token names, symbols, and logos are fetched from Helius.
# If empty, the app gracefully falls back to short-mint labels.
VITE_HELIUS_API_KEY=

# Optional full Helius RPC URL override (takes precedence over VITE_HELIUS_API_KEY).
# Example: https://mainnet.helius-rpc.com/?api-key=xxxxxxxx
VITE_HELIUS_RPC_URL=
