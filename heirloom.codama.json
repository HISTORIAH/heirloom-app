{
  "idl": "target/idl/heirloom.json",
  "before": [
    {
      "from": "@codama/visitors#updateInstructionsVisitor",
      "args": [
        {
          "initialize": {
            "accounts": { "assetRecord": { "defaultValue": false } }
          },
          "registerAsset": {
            "accounts": { "assetRecord": { "defaultValue": false } }
          },
          "claim": {
            "accounts": { "assetRecord": { "defaultValue": false } }
          },
          "revoke": {
            "accounts": { "assetRecord": { "defaultValue": false } }
          },
          "updateHeir": {
            "accounts": {
              "assetRecord": { "defaultValue": false },
              "newAssetRecord": { "defaultValue": false }
            }
          }
        }
      ]
    }
  ],
  "scripts": {
    "js": {
      "from": "@codama/renderers-js",
      "args": ["clients/heirloom/js"]
    },
    "rust": {
      "from": "@codama/renderers-rust",
      "args": [
        "clients/heirloom/rust",
        {
          "formatCode": true
        }
      ]
    }
  }
}
