{
  "name": "heirloom-monorepo",
  "private": true,
  "workspaces": [
    "app",
    "clients/*",
    "tests",
    "blog"
  ],
  "scripts": {
    "dev:ui": "turbo run dev --filter=app",
    "build:ui": "turbo run build --filter=app",
    "build": "turbo run build",
    "convert-idl": "bun run scripts/convert-idl.ts",
    "generate:clients": "bun convert-idl && bunx codama run --all",
    "deploy": "bash scripts/deploy.sh",
    "test": "turbo run test",
    "airdrop": "bash scripts/airdrop.sh"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.4.0",
    "@codama/renderers-js": "^2.1.0",
    "@codama/renderers-rust": "^3.0.0",
    "turbo": "latest",
    "typescript": "^5.8.0"
  },
  "packageManager": "bun@1.3.9"
}
