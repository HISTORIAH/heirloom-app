{
  "name": "heirloom-monorepo",
  "private": true,
  "workspaces": [
    "app",
    "landing",
    "docs",
    "app-ika",
    "waitlist",
    "blog",
    "packages/*",
    "clients/heirloom/js",
    "clients/heirloom-ika/js"
  ],
  "scripts": {
    "dev:app": "turbo run dev --filter=app",
    "dev:app-ika": "turbo run dev --filter=app-ika",
    "dev:blog": "turbo run dev --filter=blog",
    "dev:docs": "turbo run dev --filter=docs",
    "dev:landing": "turbo run dev --filter=landing",
    "dev:waitlist": "turbo run dev --filter=waitlist",
    "build:app": "turbo run build --filter=app",
    "build:app-ika": "turbo run build --filter=app-ika",
    "build:blog": "turbo run build --filter=blog",
    "build:docs": "turbo run build --filter=docs",
    "build:landing": "turbo run build --filter=landing",
    "build:waitlist": "turbo run build --filter=waitlist",
    "build:web": "turbo run build --filter=landing --filter=docs --filter=blog && rm -rf landing/dist/docs landing/dist/blog && cp -r docs/dist landing/dist/docs && cp -r blog/dist landing/dist/blog",
    "deploy:web": "bun run build:web && bunx wrangler deploy --config landing/wrangler.jsonc",
    "generate:heirloom": "bunx codama run --all -c heirloom.codama.json",
    "generate:heirloom-ika": "bunx codama run --all -c heirloom-ika.codama.json",
    "generate": "bun run generate:heirloom && bun run generate:heirloom-ika",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.4",
    "@codama/renderers-js": "^2.3.1",
    "@codama/renderers-rust": "^3.1.3",
    "@codama/visitors": "^1.10.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.11",
    "typescript": "^7.0.2",
    "wrangler": "^4.124.0"
  },
  "packageManager": "bun@1.4.0"
}
