{
  "name": "heirloom-monorepo",
  "private": true,
  "workspaces": [
    "app",
    "app-ika",
    "packages/*",
    "clients/*",
    "clients-ika/*",
    "tests"
    "blog"
  ],
  "scripts": {
    "dev:ui": "turbo run dev --filter=app",
    "dev:ika": "turbo run dev --filter=app-ika",
    "build:ui": "turbo run build --filter=app",
    "build": "turbo run build",
    "convert-idl": "bun run scripts/convert-idl.ts",
    "convert-idl:ika": "bun run scripts/convert-idl-ika.ts",
    "generate:clients": "bun convert-idl && bunx codama run --all",
    "generate:ika-clients": "bun convert-idl:ika && bunx codama run --all",
    "generate:all-clients": "bun generate:clients && bun generate:ika-clients",
    "deploy": "bash scripts/deploy.sh",
    "test": "turbo run test",
    "airdrop": "bash scripts/airdrop.sh"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.4.0",
    "@codama/renderers-js": "^2.1.0",
    "@codama/renderers-rust": "^3.0.0",
    "turbo": "latest",
    "typescript": "^5.8.0"
  },
  "packageManager": "bun@1.3.9"
}
