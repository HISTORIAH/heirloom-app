{
  "name": "heirloom-monorepo",
  "private": true,
  "workspaces": [
    "app",
    "clients/*",
    "tests"
  ],
  "scripts": {
    "dev:ui": "turbo run dev --filter=app",
    "build": "turbo run build",
    "convert-idl": "bun run scripts/convert-idl.ts",
    "generate:clients": "bun convert-idl && bunx codama run --all",
    "deploy": "bash scripts/deploy.sh",
    "test": "turbo run test",
    "airdrop": "bash scripts/airdrop.sh"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.4.0",
    "@codama/renderers-js": "^2.1.0",
    "@codama/renderers-rust": "^3.0.0",
    "turbo": "latest"
  },
  "packageManager": "yarn@4.1.0+sha512.5b7bc055cad63273dda27df1570a5d2eb4a9f03b35b394d3d55393c2a5560a17f5cef30944b11d6a48bcbcfc1c3a26d618aae77044774c529ba36cb771ad5b0f"
}
