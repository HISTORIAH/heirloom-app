---
/**
 * The docs chrome. It mirrors the landing's bar — same height rule, same
 * hairline, same yellow hand-off button — with one difference: "Docs" is a
 * destination here rather than a link, so it carries the current-page rule.
 * The nav matches the blog header: Home, Docs, Blog.
 *
 * The sidebar toggle lives in here too. Below 900px the two rails collapse and
 * this button is the only way back to the table of contents, so it is chrome,
 * not a sidebar affordance.
 */
import { appPath, BLOG_HREF, HOME_HREF, withBase } from "@/lib/site";
import Button from "@/components/Button.astro";
import Icon from "@/components/Icon.astro";
import Logo from "@/components/Logo.astro";

---

<header class="sticky top-0 z-50 border-b border-tile-line bg-background/95 backdrop-blur">
  <div class="flex h-[var(--nav-h)] items-center gap-4 px-[var(--page-pad)]">
    <a href={HOME_HREF} class="flex shrink-0 items-center" aria-label="Heirloom home">
      <Logo class="h-8 md:h-[var(--nav-logo-h)]" />
    </a>

    <nav class="hidden flex-1 items-center justify-center gap-1 lg:flex" aria-label="Site">
      <a
        href={HOME_HREF}
        class="flex min-h-[var(--nav-link-h)] items-center rounded-lg px-[var(--nav-link-px)] text-[length:var(--nav-text)] font-bold uppercase tracking-[0.12em] text-foreground/75 transition-colors hover:bg-tile-soft hover:text-foreground"
      >
        Home
      </a>
      <span
        aria-current="page"
        class="relative flex min-h-[var(--nav-link-h)] items-center rounded-lg px-[var(--nav-link-px)] text-[length:var(--nav-text)] font-bold uppercase tracking-[0.12em] text-foreground"
      >
        Docs
        <span class="absolute inset-x-[var(--nav-link-px)] -bottom-[3px] h-[3px] bg-accent-yellow"></span>
      </span>
      <a
        href={BLOG_HREF}
        class="flex min-h-[var(--nav-link-h)] items-center rounded-lg px-[var(--nav-link-px)] text-[length:var(--nav-text)] font-bold uppercase tracking-[0.12em] text-foreground/75 transition-colors hover:bg-tile-soft hover:text-foreground"
      >
        Blog
      </a>
    </nav>

    <div class="ml-auto flex items-center gap-2 lg:ml-0">
      <a
        href={withBase("/reference/faq/")}
        class="hidden flex min-h-[var(--nav-link-h)] items-center rounded-lg px-[var(--nav-link-px)] text-[length:var(--nav-text)] font-bold uppercase tracking-[0.12em] text-foreground/75 transition-colors hover:bg-tile-soft hover:text-foreground sm:flex"
      >
        FAQ
      </a>
      <Button
        href={appPath("/create-vault")}
        variant="flat-yellow"
        size="sm"
        class="ml-2 h-[var(--nav-link-h)] px-[calc(var(--nav-link-px)*1.2)] text-[length:var(--nav-text)] tracking-[0.12em]"
        data-track="docs_nav_launch_app"
      >
        Launch App
      </Button>
      <button
        type="button"
        class="rounded-md border border-tile-line p-2 transition-colors hover:bg-tile-soft lg:hidden"
        data-sidebar-toggle
        aria-expanded="false"
        aria-controls="docs-sidebar"
        aria-label="Open documentation menu"
      >
        <Icon name="menu" data-sidebar-icon-open class="h-4 w-4" strokeWidth={2} />
        <Icon name="x" data-sidebar-icon-close class="h-4 w-4" strokeWidth={2} hidden />
      </button>
    </div>
  </div>
</header>
