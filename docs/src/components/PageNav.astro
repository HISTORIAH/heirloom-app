---
/**
 * Previous / next, in the book's reading order. A docs site without these
 * makes every page a dead end for anyone who did not arrive with a question.
 */
import type { NavItem } from "@/lib/nav";
import Icon from "@/components/Icon.astro";

interface Props {
  prev?: NavItem;
  next?: NavItem;
}
const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="mt-16 grid gap-3 border-t border-tile-line pt-8 sm:grid-cols-2" aria-label="Pagination">
      {prev ? (
        <a
          href={prev.href}
          class="group rounded-lg border border-tile-line p-4 transition-colors hover:border-foreground"
        >
          <span class="ed-label flex items-center gap-1.5">
            <Icon name="arrow-left" class="h-3 w-3" strokeWidth={2.5} />
            Previous
          </span>
          <span class="mt-1.5 block font-display text-[15px] font-bold">{prev.title}</span>
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a
          href={next.href}
          class="group rounded-lg border border-tile-line p-4 text-right transition-colors hover:border-foreground sm:col-start-2"
        >
          <span class="ed-label flex items-center justify-end gap-1.5">
            Next
            <Icon name="arrow-right" class="h-3 w-3" strokeWidth={2.5} />
          </span>
          <span class="mt-1.5 block font-display text-[15px] font-bold">{next.title}</span>
        </a>
      )}
    </nav>
  )
}
