{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "android": {
      "cache": false,
      "persistent": true
    },
    "release:devnet": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["SSH_AUTH_SOCK", "GPG_TTY", "GNUPGHOME"]
    },
    "release:mainnet": {
      "cache": false,
      "interactive": true,
      "passThroughEnv": ["SSH_AUTH_SOCK", "GPG_TTY", "GNUPGHOME"]
    },
    "test": {
      "dependsOn": ["build"]
    }
  },
  "globalPassThroughEnv": ["ANDROID_HOME", "JAVA_HOME"]
}
