# Cluster name the UI labels itself with. "devnet" | "mainnet" | "localnet".
VITE_NETWORK=devnet

# Backend origin only — src/services/api/_http.ts appends "/v1/ika".
VITE_BACKEND_URL=https://api.heirloom.xyz

VITE_IKA_GRPC_URL=https://api.heirloom.xyz/v1/ika

# Required: address() is called on this at module load, so it cannot be empty.
VITE_IKA_DWALLET_PROGRAM_ID=6H2DF6MmP51fQDnB1KTUV3AbmCw7AkDDgNM9Cvegn4ys
