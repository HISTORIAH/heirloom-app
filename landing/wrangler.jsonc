{
  // The public-facing web: marketing site, docs handbook, and blog — all
  // prerendered static assets served from the apex domain. The `docs` and
  // `blog` packages build into this one's dist at the root level via
  // `bun run build:web`. No worker code, no SPA fallback — every URL has a
  // real file behind it.
  //
  // Deployed automatically via CI/CD on push or merge to main.
  "name": "heirloom-landing",
  "compatibility_date": "2026-04-18",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "heirlm.xyz", "custom_domain": true },
    { "pattern": "www.heirlm.xyz", "custom_domain": true }
    // docs.heirlm.xyz is deliberately absent. Binding it without a redirect
    // would serve this same site on a second hostname — duplicate content on a
    // domain whose whole point was to stop being separate.
  ],
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {
      "name": "heirloom-landing-preview"
    }
  }
}
