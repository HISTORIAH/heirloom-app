---
/**
 * The band a section opens on: headline across the left of the page, lede set
 * against the right margin. It sits above the mosaic rather than inside it —
 * a headline is type on the page, and giving it grid rows of its own only
 * bought empty space once sections started filling the screen.
 *
 * `more` closes the lede with a link to the docs page that explains the
 * section in depth. The anchor text says what is there, so the link tells
 * both readers and crawlers where it leads.
 */
import { cn } from "@/lib/cn";
import Icon from "@/components/Icon.astro";

interface Props {
  class?: string;
  more?: { href: string; label: string };
}

const { class: className, more } = Astro.props;
const hasLede = Astro.slots.has("lede");
---

<div class={cn("grid grid-cols-1 gap-5 lg:grid-cols-12 lg:items-end lg:gap-8", className)}>
  <h2 class="ed-h2 lg:col-span-7"><slot name="headline" /></h2>
  {
    hasLede && (
      <p class="ed-lede max-w-[46ch] text-muted-foreground lg:col-span-5 lg:ml-auto lg:text-right">
        <slot name="lede" />
        {more && (
          <a
            href={more.href}
            class="mt-4 flex items-center gap-1.5 text-[15px] font-bold text-foreground underline-offset-4 hover:underline lg:justify-end"
          >
            {more.label}
            <Icon name="arrow-right" aria-hidden="true" class="h-4 w-4 shrink-0" strokeWidth={2.5} />
          </a>
        )}
      </p>
    )
  }
</div>
