---
import type { LandingT } from "@heirloom/i18n/landing";
import { cn } from "@/lib/cn";
import Logo from "@/components/Logo.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { DOCS_URL, GITHUB_URL, TWITTER_URL } from "@/lib/site";

interface Props {
  t: LandingT;
  locale: string;
}
const { t, locale } = Astro.props;

const linkGroups = [
  {
    heading: t("footer.protocol"),
    links: [
      { name: t("footer.documentation"), href: DOCS_URL },
      { name: t("footer.github"), href: GITHUB_URL },
    ],
  },
  {
    heading: t("footer.community"),
    links: [{ name: t("footer.twitter"), href: TWITTER_URL }],
  },
];
---

{/* Light footer: the CTA above it is the page's one full ink block, and a
    second black mass underneath would swallow it. */}
<footer class="border-t border-tile-line pb-12 pt-16">
  <div class="section-inner">
    {/* Twelve columns, like the page above it: the mark holds the left
        half and the link columns stand against the right margin. */}
    <div class="mb-14 grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-6 lg:col-span-5">
        <h3><Logo tone="ink" class="h-12 md:h-14" /></h3>
        <p class="ed-body mt-5 max-w-[42ch] text-muted-foreground">{t("footer.lede")}</p>
      </div>

      {
        linkGroups.map((group, i) => (
          <div class={cn("md:col-span-3", i === 0 && "lg:col-start-8")}>
            <h4 class="text-[11px] font-bold uppercase tracking-[0.16em] text-muted-foreground">
              {group.heading}
            </h4>
            <ul class="mt-4 space-y-2.5">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-base font-bold underline-offset-4 transition-colors hover:underline"
                    target={link.href.startsWith("http") ? "_blank" : undefined}
                    rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                  >
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="flex flex-col items-start justify-between gap-4 border-t border-tile-line pt-7 md:flex-row md:items-center"
    >
      <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
        {t("footer.legalNote")}
      </p>
      <div class="flex items-center gap-6">
        <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">
          {t("footer.poweredBy")}
        </p>
        <LanguageSwitcher locale={locale} />
      </div>
    </div>
  </div>
</footer>
