{
  // Replaces Zed's default list, so the defaults are repeated first.
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // 70k+ folders, and Gradle writes native build output into it. Watching it pins the CPU.
    // Go-to-definition into packages still works: the language server reads them from disk.
    "**/node_modules",
    // Rust build output, ~9 GB.
    "target",
    // Generated by `expo prebuild`; its build/ folders run past a gigabyte.
    "mobile/android",
    // Tangem's SDK source, pinned and compiled as-is. Not ours to edit.
    "mobile/modules/tangem-card/vendor",
    "mobile/modules/*/android/build",
    "mobile/modules/*/android/sdk/*/build"
  ],
  "languages": {
    "TypeScript": {
      "formatter": "prettier",
      "format_on_save": "on",
      "prettier": {
        "allowed": true
      },
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "TSX": {
      "formatter": "prettier",
      "format_on_save": "on",
      "prettier": {
        "allowed": true
      },
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "JavaScript": {
      "formatter": "prettier",
      "format_on_save": "on",
      "prettier": {
        "allowed": true
      }
    },
  },
  "lsp": {
    "typescript-ls": {
      "settings": {
        "package_version": "7.0.2"
      }
    }
  }
}
