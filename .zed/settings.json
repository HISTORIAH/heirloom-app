{
  // Replaces Zed's default list, so the defaults are repeated first.
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // Gradle writes native build output into each React Native package (~18k folders), and
    // rescanning it on every mobile build pins the CPU. node_modules itself must stay visible:
    // without it the TypeScript 7 server reports packages as not installed.
    "**/node_modules/**/android/build",
    "**/node_modules/**/android/.cxx",
    "**/node_modules/**/android/.gradle",
    // Rust build output, ~9 GB.
    "target",
    // Generated by `expo prebuild`; its build/ folders run past a gigabyte.
    "mobile/android",
    // Tangem's SDK source, pinned and compiled as-is. Not ours to edit.
    "mobile/modules/tangem-card/vendor",
    "mobile/modules/*/android/build",
    "mobile/modules/*/android/sdk/*/build"
  ],
  "languages": {
    "TypeScript": {
      "formatter": "prettier",
      "format_on_save": "on",
      "prettier": {
        "allowed": true
      },
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "TSX": {
      "formatter": "prettier",
      "format_on_save": "on",
      "prettier": {
        "allowed": true
      },
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    },
    "JavaScript": {
      "formatter": "prettier",
      "format_on_save": "on",
      "prettier": {
        "allowed": true
      }
    },
  },
  "lsp": {
    "typescript-ls": {
      "settings": {
        "package_version": "7.0.2"
      }
    }
  }
}
