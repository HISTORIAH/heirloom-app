---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  slug: string;
  draft?: boolean;
  featured?: boolean;
  /** Minutes, from lib/readingTime.ts. Omitted, the meta line leaves it out. */
  readingTime?: number;
}

const { title, description, pubDate, tags, slug, draft, featured, readingTime } = Astro.props;

const tagColors: Record<string, string> = {
  announcement: "post-tag--outline",
  essay: "post-tag--sage",
  technical: "post-tag--sky",
  guide: "post-tag--sage",
  update: "post-tag--yellow",
};

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-US", {
    month: "short",
    day: "numeric",
    year: "numeric",
  });
}
---

{/* The whole card is clickable, but the link itself is the title, stretched
    over the card by .post-card-link::after. Wrapping the card in one <a> made
    its anchor text the tag, title, excerpt and date run together. */}
<article class:list={["post-card", { "post-card--featured": featured }]}>
  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
    {tags.map((tag) => (
      <span class:list={["post-tag", tagColors[tag] || "post-tag--outline"]}>{tag}</span>
    ))}
    {draft && <span class="draft-badge">Draft</span>}
  </div>
  <h2><a href={`/blog/${slug}/`} class="post-card-link">{title}</a></h2>
  <p class="post-excerpt">{description}</p>
  <div class="post-meta">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {
      readingTime && (
        <>
          <span class="dot" />
          <span>{readingTime} min read</span>
        </>
      )
    }
  </div>
</article>
