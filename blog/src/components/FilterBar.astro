---
interface Props {
  activeTag?: string;
  tags: string[];
}

const { activeTag, tags } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<div class="filter-bar">
  <span class="ed-label">Filter</span>
  <a href={base} class:list={["filter-pill", { active: !activeTag }]}>All</a>
  {
    tags.map((tag) => (
      <a
        href={`${base}tag/${tag}/`}
        class:list={["filter-pill", { active: activeTag === tag }]}
      >
        {tag}
      </a>
    ))
  }
</div>
