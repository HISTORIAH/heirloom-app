---
import { getCollection } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import PostCard from "@/components/PostCard.astro";
import FilterBar from "@/components/FilterBar.astro";

const isDev = import.meta.env.DEV;

// In dev, show drafts. In prod, filter them out.
const posts = (await getCollection("blog"))
  .filter((p) => isDev || !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect all unique tags
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

// Separate featured (latest announcement) from regular posts
const featured = posts.find((p) => p.data.featured && p.data.tags.includes("announcement"));
const regular = posts.filter((p) => p !== featured);
---

<BlogLayout
  title="Solana inheritance and wallet recovery"
  description="Engineering deep-dives, product updates, and essays on self-custody inheritance and wallet recovery on Solana, from the team building Heirloom."
>
  <section class="hero">
    <div class="shell">
      <div class="hero-label">
        <span class="ed-label">The Heirloom Blog</span>
      </div>
      <h1 class="hero-display">
        Thoughts on<br />
        <em>digital legacy</em><br />
        &amp; onchain inheritance.
      </h1>
      <p class="hero-sub ed-lede">
        What we're shipping, how it works under the hood,
        and why on-chain inheritance on Solana matters.
      </p>
    </div>
  </section>

  <div class="shell">
    <FilterBar tags={allTags} />

    <div class="post-grid">
      {featured && (
        <PostCard
          title={featured.data.title}
          description={featured.data.description}
          pubDate={featured.data.pubDate}
          tags={featured.data.tags}
          slug={featured.id}
          draft={featured.data.draft}
          featured={true}
        />
      )}

      {
        regular.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            tags={post.data.tags}
            slug={post.id}
            draft={post.data.draft}
          />
        ))
      }
    </div>
  </div>
</BlogLayout>
