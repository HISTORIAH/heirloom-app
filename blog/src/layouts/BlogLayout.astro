---
import "../styles/blog.css";
import TopNav from "@/components/TopNav.astro";
import Footer from "@/components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  /** Site-relative path (including the /blog base), e.g. /blog/images/cover.png */
  image?: string;
  canonical?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Keep the page out of the index but let crawlers follow its links. */
  noindex?: boolean;
  /** Structured data for the page, emitted as one ld+json block. */
  jsonLd?: object[];
}

const {
  title,
  description,
  image,
  canonical,
  type = "website",
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
// Pages without a cover share the landing's card, served from the same origin.
const imageUrl = new URL(image ?? "/og-image.png", Astro.site).href;
const robots = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — Heirloom Blog</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={robots} />
    <link rel="alternate" type="application/rss+xml" title="Heirloom Blog" href={`${base}rss.xml`} />
    <meta property="og:site_name" content="Heirloom Blog" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta property="og:image" content={imageUrl} />
    {image && <meta property="og:image:width" content="1200" />}
    {image && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@heirloom_app" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={imageUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <TopNav />
    <slot />
    <Footer />
  </body>
</html>
