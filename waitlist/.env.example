# Resend — server-only secrets. Do NOT prefix with VITE_ (would leak into the client bundle).
# Get the key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Audience id from https://resend.com/audiences (this is your waitlist list)
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Verified sending identity on your domain, e.g. "Heirloom <hello@heirlm.xyz>"
RESEND_FROM=Heirloom <hello@heirlm.xyz>
